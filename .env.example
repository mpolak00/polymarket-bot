# ── Telegram API credentials ───────────────────────────────────────────────────
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_PHONE=+38160XXXXXXX          # your phone number in international format

# The Telegram bot/channel to monitor
WHALE_BOT_USERNAME=PredictionRadarBot
TELEGRAM_SESSION_NAME=polymarket_watcher

# ── Polymarket / Polygon wallet ────────────────────────────────────────────────
# Private key of the Polygon wallet that holds USDC on Polymarket
# NEVER commit this value to git!
POLYGON_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# ── Trading parameters ─────────────────────────────────────────────────────────
# Hard cap: never spend more than this USDC per copied trade
MAX_TRADE_SIZE_USDC=50

# Soft cap: never spend more than this % of total wallet balance per trade
MAX_TRADE_PCT=0.05

# Ignore whale trades smaller than this (filter noise)
MIN_WHALE_SIZE_USDC=5000

# Proportional scaling: your_bet = whale_bet * COPY_SCALE_FACTOR
# e.g. whale bets $100,000 → you bet $100,000 * 0.001 = $100 (then capped above)
COPY_SCALE_FACTOR=0.001

# Skip markets with implied probability outside this range (0–1)
MIN_PROBABILITY=0.05
MAX_PROBABILITY=0.95

# Accept up to this slippage vs quoted probability
SLIPPAGE_TOLERANCE=0.02

# Minimum seconds before copying the same market again
MARKET_COOLDOWN_SECS=300

# ── Rate limiting & daily caps ─────────────────────────────────────────────────
# Max trades per hour (0 = unlimited)
MAX_TRADES_PER_HOUR=10

# Max USDC to spend in a calendar day (0 = unlimited)
MAX_DAILY_LOSS_USDC=500

# ── Market resolution ──────────────────────────────────────────────────────────
# Fuzzy-match strictness: 0.0 = accept anything, 1.0 = exact match only
FUZZY_MATCH_CUTOFF=0.5

# Minimum market liquidity (USD) to trade; skip illiquid markets
MIN_LIQUIDITY_USDC=1000

# ── Reliability ────────────────────────────────────────────────────────────────
# How many times to retry a failed order placement
ORDER_RETRY_ATTEMPTS=3

# Ignore Telegram messages older than this many seconds (stale signals)
MAX_MESSAGE_AGE_SECS=120

# ── Misc ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Set to "true" to simulate trades without spending real money
DRY_RUN=true
